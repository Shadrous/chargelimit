<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Runs once at boot, re-applies the saved limit, and exits. Nothing stays resident. -->
    <key>Label</key>
    <string>local.chargelimit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/chargelimit</string>
        <string>apply</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LaunchOnlyOnce</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/chargelimit.log</string>
</dict>
</plist>
